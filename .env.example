# Production supplies these as real environment variables instead.

RAGX_ENVIRONMENT=development
RAGX_DEBUG=true
RAGX_LOG_LEVEL=DEBUG
RAGX_DATABASE_URL=postgresql+asyncpg://ragx:ragx@localhost:5432/ragx
RAGX_REDIS_URL=redis://localhost:6379/0
RAGX_SECRET_KEY=dev-insecure-secret-key
RAGX_ACCESS_TOKEN_EXPIRE_MINUTES=60